# ============================================================================
# PolFin contracts · plantilla de entorno para Hardhat.
#   cp .env.example .env
# El .env real está gitignoreado (las private keys NUNCA se suben).
# Estas mismas variables (con los mismos nombres) también las lee el backend
# desde backend/.env — ver backend/.env.example.
# ============================================================================

# RPC de la red contra la que vayas a compilar/deployar
POLFIN_FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
POLFIN_AVALANCHE_RPC_URL=https://api.avax.network/ext/bc/C/rpc

# Private key de la wallet operadora que firma el deploy — UNA POR RED (nunca
# la misma clave en las dos), así una wallet de prueba nunca puede tocar mainnet.
POLFIN_OPERATOR_PRIVATE_KEY_FUJI=
POLFIN_OPERATOR_PRIVATE_KEY_AVALANCHE=

# API key de 0xgasless (dashboard.0xgasless.com) — un proyecto por red. La usa
# el script de deploy para calcular la Smart Account a la que se le transfiere
# el ownership de los contratos al final del deploy.
POLFIN_0XGASLESS_API_KEY_FUJI=
POLFIN_0XGASLESS_API_KEY_AVALANCHE=
