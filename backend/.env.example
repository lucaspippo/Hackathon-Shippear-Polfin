# ============================================================================
# PolFin · plantilla de entorno. Copiala a backend/.env y completá las keys:
#   cp .env.example .env
# El .env real está gitignoreado (la key NUNCA se sube). Los scripts de
# package.json ya cargan .env con Node nativo (--env-file-if-exists).
# ============================================================================

# mock (default, sin key) | anthropic (API directa) | gateway (Vercel/V0)
LLM_MODE=gateway

# --- GATEWAY (Vercel/V0) -----------------------------------------------------
# Key del AI Gateway de Vercel. Doc: vercel.com/docs/ai-gateway
AI_GATEWAY_API_KEY=
# Modelo expuesto por el Gateway, prefijado por proveedor (último Sonnet).
GATEWAY_MODEL=anthropic/claude-sonnet-5

# --- ANTHROPIC DIRECTO (opcional) --------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
