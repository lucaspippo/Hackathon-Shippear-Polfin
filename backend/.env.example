# ============================================================================
# PolFin · plantilla de entorno. Copiala a backend/.env y completá las keys:
#   cp .env.example .env
# El .env real está gitignoreado (la key NUNCA se sube). Los scripts de
# package.json ya cargan .env con Node nativo (--env-file-if-exists).
# ============================================================================

# mock (default, sin key) | anthropic (API directa) | gateway (Vercel/V0)
LLM_MODE=gateway

# --- GATEWAY (Vercel/V0) -----------------------------------------------------
# Key del AI Gateway de Vercel. Doc: vercel.com/docs/ai-gateway
AI_GATEWAY_API_KEY=
# Modelo expuesto por el Gateway, prefijado por proveedor (último Sonnet).
GATEWAY_MODEL=anthropic/claude-sonnet-5

# --- ANTHROPIC DIRECTO (opcional) --------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- ON-CHAIN (Avalanche, vía 0xgasless) -------------------------------------
# mock (default, sin key) | fuji (testnet, wallet de prueba) | avalanche (mainnet, wallet real)
POLFIN_CHAIN_MODE=mock

# RPC de cada red (podés dejar los públicos por default)
POLFIN_FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
POLFIN_AVALANCHE_RPC_URL=https://api.avax.network/ext/bc/C/rpc

# Private key de la wallet operadora — UNA POR RED, nunca la misma clave en las
# dos (para no confundir la wallet de prueba con la que tiene fondos reales).
# Nunca se commitea.
POLFIN_OPERATOR_PRIVATE_KEY_FUJI=
POLFIN_OPERATOR_PRIVATE_KEY_AVALANCHE=

# Bundler + Paymaster de 0xgasless (dashboard.0xgasless.com) — un paymaster
# por red (creado ahí eligiendo la chain — Avalanche o Avalanche Fuji — y la
# wallet address del operador de esa red), así el gas tank de testnet y el de
# mainnet quedan separados. El dashboard entrega dos URLs con la key ya
# embebida en el path (no una API key suelta).
POLFIN_0XGASLESS_BUNDLER_URL_FUJI=
POLFIN_0XGASLESS_PAYMASTER_URL_FUJI=
POLFIN_0XGASLESS_BUNDLER_URL_AVALANCHE=
POLFIN_0XGASLESS_PAYMASTER_URL_AVALANCHE=
